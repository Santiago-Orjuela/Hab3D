# Hab3D .gitignore

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env/
.venv/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data/cache
*.dat
*.csv
*.npz
*.pkl

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
build/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.directory

# Generated images/figures
figures/*.png
figures/*.pdf

# PlanetaryGrid compiled/intermediate
PlanetaryGrid/__pycache__/

# Temporary
*.tmp
*.bak
~$*

# ============================================================================
# PROJECT-SPECIFIC EXCLUSIONS / EXCLUSIONES ESPECÍFICAS DEL PROYECTO
# ============================================================================

# Exclude work-in-progress documents / Excluir documentos en progreso
Tareas.md
Temas de Discusión.md

# Exclude LaTeX project folders / Excluir carpetas de proyectos LaTeX
Textos/Proyecto/
Textos/Anteproyecto/

# Exclude exploratory notebooks / Excluir notebooks exploratorios
Codigos-Scripts/BurnMan.ipynb
Codigos-Scripts/phase_diagram_salinity.ipynb
Codigos-Scripts/TRAPPIST-1e.ipynb

# Ignore large raw grid files if any (uncomment as needed)
# PlanetaryGrid/**/*.dat

# Private writing (keep outside GitHub)
Textos/Anteproyecto/
Textos/Proyecto/
Tareas.md
Temas de Discusión.md
Privado/
